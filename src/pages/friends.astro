---
import CommentSection from "../components/CommentSection.astro";
import PageHeader from "../components/PageHeader.astro";
import Box from "../components/layout/Box.astro";
import Cell from "../components/layout/Cell.astro";
import { FRIEND_LINKS, HOME, PAGE_COPY, SITE_TITLE } from "../consts";
import SiteLayout from "../layouts/SiteLayout.astro";
import { withBase } from "../utils/withBase";

const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href.replace(/\/$/, "");
const avatarUrl = new URL(withBase(HOME.avatar.src), Astro.site).href;
const exchangeFields = [
  { label: "名称", key: "Name", value: SITE_TITLE },
  { label: "简介", key: "Desc", value: HOME.motto },
  { label: "链接", key: "Link", value: siteUrl, href: siteUrl },
  { label: "头像", key: "Avatar", value: avatarUrl, href: avatarUrl },
];
const ownFriendLinkText = exchangeFields.map(({ key, value }) => `${key}: ${value}`).join("\n");
const copyButtonClass = "chip chip-link data-[state=success]:text-accent data-[state=error]:text-content";
---

<SiteLayout title={`${PAGE_COPY.friends.title} | ${SITE_TITLE}`} description={PAGE_COPY.friends.description}>
  <PageHeader title={PAGE_COPY.friends.title} description={PAGE_COPY.friends.description} descriptionItalic={PAGE_COPY.friends.descriptionItalic} count={{ value: FRIEND_LINKS.length, unit: "位" }} />
  <div class="grid items-start gap-box md:grid-cols-sidebar">
    <Box>
      <ul class="divide-y divide-border">
        {FRIEND_LINKS.map((link) => (
          <li>
            <Cell as="a" interactive class="group grid grid-cols-[2.5rem_minmax(0,1fr)] items-center gap-3 no-underline" href={link.link ?? link.url} target="_blank" rel="noopener noreferrer">
              {link.avatar
                ? <img class="size-10 rounded-box object-cover" src={link.avatar} alt="" width="40" height="40" loading="lazy" />
                : <span class="grid size-10 place-items-center rounded-box bg-surface-alt text-heading" aria-hidden="true">{link.name.slice(0, 1)}</span>}
              <span class="min-w-0">
                <strong class="block text-card text-heading group-hover:text-accent">{link.name}</strong>
                <small class="mt-0.5 block text-body text-content">{link.desc ?? link.description}</small>
              </span>
            </Cell>
          </li>
        ))}
      </ul>
    </Box>
    <Box as="section">
      <Cell as="header" variant="header" class="flex items-center justify-between gap-3">
        <h2 class="text-section text-heading">交换友链</h2>
        <button class={copyButtonClass} type="button" data-copy-text={ownFriendLinkText} aria-live="polite">复制</button>
      </Cell>
      <Cell class="grid grid-cols-[2.5rem_minmax(0,1fr)] items-center gap-3">
        <img class="size-10 rounded-box object-cover" src={withBase(HOME.avatar.src)} alt="" width="40" height="40" loading="lazy" />
        <span class="min-w-0">
          <strong class="block text-card text-heading">{SITE_TITLE}</strong>
          <small class="mt-0.5 block text-body text-content">{HOME.motto}</small>
        </span>
      </Cell>
      <Cell>
        <dl class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3 gap-y-2 text-body">
          {exchangeFields.filter(({ href }) => href).map(({ label, value, href }) => (
            <>
              <dt class="chip">{label}</dt>
              <dd class="min-w-0 break-all"><a class="text-accent underline decoration-accent/40 hover:text-accent hover:decoration-current" href={href} target="_blank" rel="noopener noreferrer">{value}</a></dd>
            </>
          ))}
        </dl>
      </Cell>
      <Cell><p class="text-body text-subtle">复制以上信息，在下方评论区留言即可。</p></Cell>
    </Box>
  </div>
  <CommentSection />
</SiteLayout>
