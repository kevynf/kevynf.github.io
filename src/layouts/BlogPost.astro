---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import Badge from "../components/Badge.astro";
import CommentSection from "../components/CommentSection.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Meta from "../components/Meta.astro";
import Prose from "../components/Prose.astro";
import TableOfContents from "../components/TableOfContents.astro";
import Box from "../components/layout/Box.astro";
import Cell from "../components/layout/Cell.astro";
import { estimateReadingMinutes, tagPath } from "../utils/content";
import { withBase } from "../utils/withBase";
import SiteLayout from "./SiteLayout.astro";

type BlogPostData = CollectionEntry<"blog">["data"];
interface Props extends BlogPostData { body?: string; headings?: MarkdownHeading[]; enableComments?: boolean }
const { title, description, pubDate, updatedDate, heroImage, tags = [], body = "", headings = [], enableComments = false } = Astro.props;
---

<SiteLayout title={title} description={description} image={heroImage} type="article">
  <Box as="header">
    <Cell variant="header">
      <h1 class="min-w-0 text-title text-heading">{title}</h1>
      <p class="mt-1 text-body">{description}</p>
    </Cell>
    <Cell class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
      {tags.length > 0 && (
        <ul class="flex flex-wrap gap-1.5" aria-label="文章标签">
          {tags.map((tag) => <li><Badge href={withBase(tagPath(tag))}>{tag}</Badge></li>)}
        </ul>
      )}
      <Meta class="ml-auto">
        <FormattedDate date={pubDate} />
        {updatedDate && <span>更新 <FormattedDate date={updatedDate} /></span>}
        <span>{estimateReadingMinutes(body)} 分钟</span>
      </Meta>
    </Cell>
  </Box>
  <div class="grid items-start gap-box md:grid-cols-toc">
    <div class="grid min-w-0 gap-box md:col-start-2">
      {heroImage && (
        <Box>
          <img class="w-full" src={withBase(heroImage)} width="840" height="420" alt={title} />
        </Box>
      )}
      <Prose><slot /></Prose>
    </div>
    <aside class="sticky top-[calc(var(--spacing-bar)+var(--spacing-box))] hidden md:col-start-1 md:row-start-1 md:block">
      <TableOfContents headings={headings} />
    </aside>
  </div>
  {enableComments && <CommentSection />}
</SiteLayout>
